{
  "name": "beacon-workshop",
  "private": true,
  "version": "0.1.0",
  "description": "Beacon Workshop — an unofficial story-driven learning adventure about working with Codex (Working MVP).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "validate:content": "tsx scripts/validate-content.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run validate:content && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@types/node": "^22.20.4",
    "jsdom": "30.1.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
